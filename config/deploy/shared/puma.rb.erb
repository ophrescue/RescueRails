root = "<%= current_path %>"
directory root

app_name = "<%= fetch(:full_app_name) %>"

bind "unix:///tmp/puma.#{app_name}.sock"

pidfile "#{root}/tmp/pids/puma.pid"
state_path "#{root}/tmp/pids/puma.state"
stdout_redirect "#{root}/log/puma.log", "#{root}/log/puma.log", true

environment "<%= fetch(:rails_env) %>"

workers <%= fetch(:puma_worker_count) %>
threads <%= fetch(:puma_min_threads) %>, <%= fetch(:puma_max_threads) %>

# Deliberately disabled (unlike unicorn.rb.erb's `preload_app true`).
# Puma does not support phased (rolling, USR1) restarts when the app
# is preloaded in the master -- preload_app forces every restart to be
# a full hot restart (USR2, see puma.service.erb), which replaces the
# master and all workers at once and produces a brief window with zero
# workers serving requests. Without it, each worker loads the app
# independently right after it forks, so a phased restart can replace
# workers one at a time while the others keep serving. Trade-off:
# slower per-worker boot and no copy-on-write memory sharing across
# workers -- accepted here in exchange for zero-downtime deploys.
#
# Must be set explicitly, not just left unset: Puma 8's
# set_conditional_default_options defaults preload_app to true
# whenever workers > 1 and forking is supported, regardless of whether
# preload_app! is ever called -- confirmed by loading this file's
# rendered config through Puma::Configuration#clamp and inspecting
# options[:preload_app]. Simply removing the preload_app! line here
# would silently keep preloading on and phased restarts unavailable.
preload_app! false

# Because the app is no longer loaded in the master, there's no shared
# AR connection to disconnect before forking and nothing to explicitly
# reconnect in each worker -- each worker's own boot process
# (config/environment.rb) establishes its own connection normally, the
# same as `rails server` does. Unicorn's before_fork/after_fork AR
# dance (and the equivalent Puma before_fork/before_worker_boot hooks
# this file used to carry) is therefore unnecessary and has been
# dropped.

worker_shutdown_timeout 30

before_restart do
  ENV['BUNDLE_GEMFILE'] = "#{root}/Gemfile"
end
